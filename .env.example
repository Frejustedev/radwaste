# Configuration Firebase (client web). Ces valeurs ne sont pas des secrets, mais la
# sécurité réelle repose sur firestore.rules + Firebase App Check.
# Copiez ce fichier en .env.local et renseignez vos valeurs (console Firebase > Paramètres du projet).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_DATABASE_ID=""
